# Copy to .env and fill in. Nothing here is optional unless marked so.
BE_DB_PATH=./brand-evidence.db
BE_STORE_PATH=./store
BE_DIGEST_PATH=./digests
# Every spelling of the mark you want on the record, comma separated.
BE_BRAND_TERMS=Northwind,North Wind,northwind.example,Northwind Ltd
# Only "wayback" is implemented in v1. Save Page Now needs an archive.org account:
# log in, open https://archive.org/account/s3.php and copy the two keys.
BE_ARCHIVE_PROVIDER=wayback
BE_WAYBACK_ACCESS_KEY=
BE_WAYBACK_SECRET_KEY=

# Optional: Reddit read-only app credentials. Missing => source disabled with a warning.
BE_REDDIT_CLIENT_ID=
BE_REDDIT_CLIENT_SECRET=
# Optional: comma-separated Google Alerts RSS feed URLs. Missing => source disabled.
BE_GOOGLE_ALERTS_FEEDS=
# Optional: web search provider ("brave") and key. Missing => source disabled.
BE_WEB_SEARCH_PROVIDER=
BE_WEB_SEARCH_API_KEY=

# RFC 3161 Time Stamping Authority. Only a hash is sent. Empty disables timestamps.
BE_TSA_URL=https://freetsa.org/tsr

# Sent in the User-Agent of every request, so a site owner can see who is
# running this. Empty means the User-Agent carries no contact URL at all.
BE_CONTACT_URL=

# Optional: JSON feed of your own publications when the publisher runs on a server.
# Items: {platform, external_url, external_id, published_at, text}.
BE_OWN_PUBLICATIONS_URL=
BE_OWN_PUBLICATIONS_TOKEN=
BE_OWN_PUBLICATIONS_AUTH=api_key

# Optional advisory classification, off by default. Never touches the evidence log.
BE_ENABLE_CLASSIFICATION=false
BE_ANTHROPIC_API_KEY=

# Optional digest email. smtp://user:pass@host:port or smtps://user:pass@host:port
BE_SMTP_URL=
BE_DIGEST_EMAIL_TO=
BE_DIGEST_EMAIL_FROM=

BE_LOG_LEVEL=info
